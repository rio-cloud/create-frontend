{
    "name": "@rio-cloud/create-frontend",
    "version": "2.0.2",
    "description": "A CLI for creating new web frontend projects from scratch",
    "author": {
        "name": "TB Digital Services GmbH",
        "email": "roland.hummel@rio.cloud"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rio-cloud/create-frontend.git"
    },
    "bugs": {
        "url": "https://github.com/rio-cloud/create-frontend/issues"
    },
    "homepage": "https://github.com/rio-cloud/create-frontend#readme",
    "type": "module",
    "engines": {
        "node": "24.x",
        "npm": ">=11.0.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "lint": "biome check",
        "lint-fix": "biome check --write",
        "format-code": "biome format --write",
        "test": "node --test"
    },
    "bin": {
        "create-frontend": "index.js"
    },
    "dependencies": {
        "@inquirer/prompts": "8.7.2",
        "boxen": "9.0.0",
        "chalk": "6.0.0",
        "cpy": "13.2.3",
        "gradient-string": "3.0.0",
        "isomorphic-git": "1.42.2",
        "listr2": "11.1.0",
        "move-file": "4.1.0",
        "replace-in-file": "9.0.0",
        "rimraf": "6.1.3",
        "zx": "8.8.5"
    },
    "files": [
        "index.js",
        "src"
    ],
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@rio-cloud/biome-config": "2.0.0"
    }
}
